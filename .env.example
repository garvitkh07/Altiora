# Public Supabase settings used by the browser and server clients.
# The anon key is designed for use with Supabase RLS; never put a service-role
# key in this file, a browser bundle, or a client-side environment variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
